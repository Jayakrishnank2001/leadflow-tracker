    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
